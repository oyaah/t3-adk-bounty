# Copy to .env (gitignored). The agent runs in honest harness mode when unset.
# AGENT_KEY: a DEDICATED BURNER Terminal 3 testnet key (Ethereum private key, 0x...).
#   Never use your main key for the public app — if the host leaks it, blast radius ~0.
AGENT_KEY=0x...
# LLM brain. Without it a fast heuristic planner is used (still trickable, still blocked).
OPENAI_API_KEY=sk-...
# Lock CORS to your frontend origin(s), comma-separated. Unset = open (local dev only).
ALLOWED_ORIGIN=https://your-app.vercel.app
# Optional: per-IP attack cap per minute (default 12).
RATE_LIMIT_PER_MIN=12
