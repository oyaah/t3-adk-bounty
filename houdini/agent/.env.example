# Copy to .env (gitignored) and fill in. The agent runs in honest harness mode
# when AGENT_KEY is unset; live mode when it is present.
# AGENT_KEY is the Terminal 3 developer key (an Ethereum private key, 0x...).
# The agent address is derived from it automatically — do not hardcode it.
AGENT_KEY=0x...
# Optional: LLM provider for the agent's intent→action reasoning (see README).
# ANTHROPIC_API_KEY=sk-ant-...
